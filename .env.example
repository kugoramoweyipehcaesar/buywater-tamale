# --- Production: Supabase PostgreSQL ---
# Pooler (app runtime on Render) — port 6543 + pgbouncer
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (prisma db push / migrations) — port 5432
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Local only (optional SQLite) ---
# Change schema provider to sqlite, remove directUrl, then:
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

JWT_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_SECRET="change-me-to-another-long-random-string"
NODE_ENV="production"
APP_URL="https://buywater-tamale.onrender.com"
SUPER_ADMIN_EMAIL="kugoramoweyipehcaesar49@gmail.com"
ADMIN_EMAIL="kugoramoweyipehcaesar49@gmail.com"
SETUP_SECRET="optional-setup-secret-for-ensure-admin"

# Optional — future Supabase client features
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Email — either SMTP_* or EMAIL_* (both supported)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kugoramoweyipehcaesar49@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="BuyWater <kugoramoweyipehcaesar49@gmail.com>"
